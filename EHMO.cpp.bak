static const QRegularExpression RE_WHITESPACE("\\s+");


namespace EHMOConstants {
    constexpr double PI = 3.14159265358979323846;
    constexpr double HARTREE_TO_EV = 27.2114;
    constexpr double ANGSTROM_TO_BOHR = 1.889725989;
    constexpr double BOHR_TO_ANGSTROM = 0.529177249;
    constexpr double WOLFSBERG_HELMHOLZ_K = 1.75;
    constexpr double EPSILON = 1e-4;
    constexpr double ISO_VALUE = 0.1;
    constexpr double INTERVAL = 0.1;
    constexpr int MAX_BASIS_FUNCTIONS = 1000;
}


int min0(int a, int b)
{
    if (a<b) return a;
    return b;
}

int min1(int a, int b, int c)
{
    int d=a;
    if(d>b)  d=b;
    if(d>c)  d=c;
    return d;
}

int max0(int a, int b)
{
    if (a<b) return b;
    return a;
}

int max1(int a, int b, int c)
{
    int d=a;
    if(d<b)  d=b;
    if(d<c)  d=c;
    return d;
}



